{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IN structured binary parser result",
  "type": "object",
  "required": ["status", "document", "segments", "warnings", "parser_version", "source_sha256", "boundary"],
  "properties": {
    "status": {"enum": ["parsed", "partial"]},
    "document": {"type": "object"},
    "segments": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["raw_text", "anchor", "data", "metadata"],
      "properties": {"raw_text": {"type": "string"}, "anchor": {"$ref": "source-anchor.schema.json"},
        "data": {"type": "object"}, "metadata": {"type": "object", "properties": {"semantic_claim_status": {"const": "not_inferred"}}, "required": ["semantic_claim_status"]}},
      "additionalProperties": false
    }},
    "warnings": {"type": "array", "items": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}},
    "parser_version": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "boundary": {"type": "string"}
  },
  "additionalProperties": false
}
