{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://yoloongppt.local/contracts/adaptive-content-result.schema.json",
  "title": "可消费的正文字符与原表行列分页映射",
  "required": [
    "version",
    "status",
    "system_acceptance",
    "policy",
    "input_pages",
    "output_pages",
    "deviation",
    "page_mappings",
    "input_sha256",
    "output_sha256",
    "conservation",
    "fallback",
    "remaining_limits",
    "execution_metadata_labels"
  ],
  "properties": {
    "version": {
      "const": "adaptive-content-1"
    },
    "status": {
      "const": "adapted"
    },
    "system_acceptance": {
      "const": "not_claimed"
    },
    "policy": {
      "$ref": "adaptive-content-policy.schema.json"
    },
    "input_pages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "output_pages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "deviation": {
      "type": "integer",
      "minimum": -29,
      "maximum": 29
    },
    "page_mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "original_page",
          "outputs",
          "original_title",
          "original_body_sha256",
          "original_notes_sha256",
          "evidence_refs",
          "assumption_refs",
          "geometry"
        ],
        "properties": {
          "original_page": {
            "type": "integer",
            "minimum": 0,
            "maximum": 29
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "output_page",
                "kind",
                "body_segments",
                "repeated_visible_markers",
                "table_coordinates",
                "notes_unchanged",
                "title_unchanged",
                "visible_pagination_notice"
              ],
              "properties": {
                "output_page": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29
                },
                "notes_unchanged": {
                  "const": true
                },
                "title_unchanged": {
                  "const": true
                },
                "body_segments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "body_item",
                      "start",
                      "end",
                      "text"
                    ],
                    "properties": {
                      "body_item": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "text": {
                        "type": "string"
                      }
                    }
                  }
                },
                "table_coordinates": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "visible_pagination_notice": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "text",
                        "source_kind",
                        "business_fact",
                        "added_to_body"
                      ],
                      "properties": {
                        "text": {
                          "const": "【原表分页展示，完整内容见同标题各页】"
                        },
                        "source_kind": {
                          "const": "execution_metadata"
                        },
                        "business_fact": {
                          "const": false
                        },
                        "added_to_body": {
                          "type": "boolean"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "output_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "conservation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_body_characters",
        "all_table_cells",
        "titles",
        "notes_unchanged",
        "evidence_refs",
        "assumption_refs"
      ],
      "properties": {
        "all_body_characters": {
          "const": true
        },
        "all_table_cells": {
          "const": true
        },
        "titles": {
          "const": true
        },
        "notes_unchanged": {
          "const": true
        },
        "evidence_refs": {
          "const": true
        },
        "assumption_refs": {
          "const": true
        }
      }
    },
    "fallback": {
      "const": "structured_failure_without_truncation"
    },
    "remaining_limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "execution_metadata_labels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "source_kind",
          "business_fact",
          "original_page",
          "output_pages",
          "tile_count"
        ],
        "properties": {
          "text": {
            "const": "【原表分页展示，完整内容见同标题各页】"
          },
          "source_kind": {
            "const": "execution_metadata"
          },
          "business_fact": {
            "const": false
          },
          "original_page": {
            "type": "integer",
            "minimum": 0,
            "maximum": 29
          },
          "output_pages": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 29
            }
          },
          "tile_count": {
            "type": "integer",
            "minimum": 2
          }
        }
      }
    }
  }
}
