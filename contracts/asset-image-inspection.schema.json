{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IN-011 AST pixel asset inspection runtime result",
  "type": "object",
  "required": ["asset_kind", "sha256", "bytes", "format", "mime_type", "width", "height", "mode", "frame_count", "has_alpha", "dominant_colors", "dominant_color_method", "semantic_status", "ocr_status", "issues"],
  "properties": {
    "asset_kind": {"const": "image"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bytes": {"type": "integer", "minimum": 1}, "format": {"type": "string"}, "mime_type": {"type": ["string", "null"]},
    "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "mode": {"type": "string"},
    "frame_count": {"type": "integer", "minimum": 1}, "has_alpha": {"type": "boolean"},
    "aspect_ratio": {"type": "number", "exclusiveMinimum": 0}, "dpi": {"type": ["array", "null"], "items": {"type": "number"}},
    "color_profile_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "perceptual_hash": {"type": "object", "required": ["algorithm", "value"], "properties": {"algorithm": {"type": "string"}, "value": {"type": "string", "pattern": "^[0-9a-f]{16}$"}}, "additionalProperties": false},
    "dominant_colors": {"type": "array", "items": {"type": "object", "required": ["color", "fraction"], "properties": {"color": {"type": "string", "pattern": "^#[0-9A-F]{6}$"}, "fraction": {"type": "number", "minimum": 0, "maximum": 1}}, "additionalProperties": false}},
    "dominant_color_method": {"type": "string"}, "semantic_status": {"const": "not_inferred"}, "ocr_status": {"const": "unsupported"}, "issues": {"type": "array", "minItems": 1}
  }, "additionalProperties": false
}
