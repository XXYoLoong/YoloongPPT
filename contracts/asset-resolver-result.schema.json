{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoloongppt.local/contracts/asset-resolver-result.schema.json",
  "type": "object",
  "required": [
    "status",
    "entries",
    "issues",
    "duplicate_groups",
    "boundary"
  ],
  "properties": {
    "status": {
      "enum": [
        "resolved",
        "partial"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "source_type",
          "source_locator",
          "source_url",
          "path",
          "sha256",
          "bytes",
          "mime_type",
          "width_px",
          "height_px",
          "inspection",
          "license",
          "usage_status",
          "authorization_basis",
          "attribution",
          "transform_history",
          "request_metadata",
          "source_refs",
          "semantic_status",
          "deliberate_reuse",
          "cache_status",
          "source_id"
        ],
        "properties": {
          "asset_id": {
            "$ref": "object-id.schema.json#/$defs/asset_id"
          },
          "source_type": {
            "enum": [
              "user",
              "local",
              "template",
              "url",
              "search",
              "generation",
              "derived"
            ]
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "mime_type": {
            "type": "string",
            "minLength": 1
          },
          "width_px": {
            "type": "integer",
            "minimum": 1
          },
          "height_px": {
            "type": "integer",
            "minimum": 1
          },
          "inspection": {
            "type": "object"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "usage_status": {
            "const": "authorized"
          },
          "authorization_basis": {
            "type": "string",
            "minLength": 1
          },
          "attribution": {
            "type": [
              "string",
              "null"
            ]
          },
          "transform_history": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "minItems": 0
          },
          "request_metadata": {
            "type": [
              "object",
              "null"
            ]
          },
          "source_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "object-id.schema.json#/$defs/evidence_id"
            }
          },
          "semantic_status": {
            "type": "string",
            "minLength": 1
          },
          "deliberate_reuse": {
            "type": "boolean"
          },
          "cache_status": {
            "const": "complete_and_hash_verified"
          },
          "source_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "object-id.schema.json#/$defs/source_id"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "minItems": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0
    },
    "duplicate_groups": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0
    },
    "boundary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
