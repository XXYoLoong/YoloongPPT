{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Object ID Convention（GOV-007 草案）",
  "description": "YoloongPPT 运行时实体 ID 与既有决策定义 ID 的格式约定。",
  "oneOf": [
    { "$ref": "#/$defs/task_id" },
    { "$ref": "#/$defs/deck_id" },
    { "$ref": "#/$defs/slide_id" },
    { "$ref": "#/$defs/section_id" },
    { "$ref": "#/$defs/source_id" },
    { "$ref": "#/$defs/evidence_id" },
    { "$ref": "#/$defs/assumption_id" },
    { "$ref": "#/$defs/asset_id" },
    { "$ref": "#/$defs/layout_id" },
    { "$ref": "#/$defs/slot_id" },
    { "$ref": "#/$defs/object_id" },
    { "$ref": "#/$defs/capability_id" },
    { "$ref": "#/$defs/implementation_id" },
    { "$ref": "#/$defs/adapter_id" },
    { "$ref": "#/$defs/candidate_id" },
    { "$ref": "#/$defs/decision_id" },
    { "$ref": "#/$defs/trace_id" },
    { "$ref": "#/$defs/issue_id" },
    { "$ref": "#/$defs/artifact_id" }
  ],
  "$defs": {
    "task_id": {
      "type": "string",
      "pattern": "^task_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "deck_id": {
      "type": "string",
      "pattern": "^deck_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "slide_id": {
      "type": "string",
      "pattern": "^slide_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "section_id": {
      "type": "string",
      "pattern": "^section_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^source_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^evidence_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "assumption_id": {
      "type": "string",
      "pattern": "^assumption_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^asset_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "layout_id": {
      "type": "string",
      "pattern": "^layout_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "slot_id": {
      "type": "string",
      "pattern": "^slot_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^object_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^capability_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "implementation_id": {
      "type": "string",
      "pattern": "^implementation_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^adapter_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^candidate_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^DEC-(00[1-9]|0[1-3][0-9]|040)$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^trace_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "issue_id": {
      "type": "string",
      "pattern": "^issue_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "requirement_registry_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){1,3}$"
    },
    "task_registry_id": {
      "type": "string",
      "pattern": "^TASK-[A-Z0-9]{2,6}-[0-9]{3}$"
    }
  }
}
