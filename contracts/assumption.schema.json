{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assumption[] 契约（CNT-004 草案）",
  "description": "登记所有显式假设，并保留其文字、理由、原始置信度表示和用户可见性状态。",
  "type": "array",
  "items": {
    "$ref": "#/$defs/assumption"
  },
  "$defs": {
    "assumption": {
      "type": "object",
      "required": [
        "assumption_id",
        "text",
        "reason",
        "confidence",
        "user_visible"
      ],
      "properties": {
        "assumption_id": {
          "$ref": "object-id.schema.json#/$defs/assumption_id"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "user_visible": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
