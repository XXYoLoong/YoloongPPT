{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoloongppt.local/contracts/revision-batch-request.schema.json",
  "title": "REV-003/004/009 bounded multi-object revision request",
  "type": "object",
  "required": ["instruction"],
  "additionalProperties": false,
  "properties": {
    "instruction": {"type": "string", "minLength": 1, "maxLength": 20000},
    "mode": {"enum": ["revision", "beautify"], "default": "revision"},
    "scope": {"$ref": "#/$defs/scope"},
    "edits": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/edit"}},
    "locked_object_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "object-id.schema.json#/$defs/object_id"}}
  },
  "$defs": {
    "scope": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "slide_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "object-id.schema.json#/$defs/slide_id"}},
        "object_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "object-id.schema.json#/$defs/object_id"}}
      }
    },
    "selector": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "slide_id": {"$ref": "object-id.schema.json#/$defs/slide_id"},
        "slide_index": {"type": "integer", "minimum": 0},
        "shape_id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "text": {"type": "string"},
        "placeholder_idx": {"type": "integer", "minimum": 0}
      }
    },
    "edit": {
      "type": "object", "required": ["operation", "value"], "additionalProperties": false,
      "properties": {
        "object_id": {"$ref": "object-id.schema.json#/$defs/object_id"},
        "selector": {"$ref": "#/$defs/selector"},
        "operation": {"enum": ["text", "image", "chart_data", "table_cell", "geometry", "format", "alt_text", "notes"]},
        "value": {}
      },
      "oneOf": [{"required": ["object_id"], "not": {"required": ["selector"]}}, {"required": ["selector"], "not": {"required": ["object_id"]}}],
      "allOf": [
        {"if": {"properties": {"operation": {"const": "text"}}}, "then": {"properties": {"value": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
        {"if": {"properties": {"operation": {"const": "image"}}}, "then": {"properties": {"value": {"type": "object", "required": ["asset_id"], "additionalProperties": false, "properties": {"asset_id": {"$ref": "object-id.schema.json#/$defs/asset_id"}}}}}},
        {"if": {"properties": {"operation": {"const": "geometry"}}}, "then": {"properties": {"value": {"type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [{"type": "number", "minimum": 0}, {"type": "number", "minimum": 0}, {"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}]}}}},
        {"if": {"properties": {"operation": {"const": "format"}}}, "then": {"properties": {"value": {"type": "object", "minProperties": 1, "additionalProperties": false, "properties": {"font": {"type": "string", "minLength": 1}, "font_size": {"type": "number", "minimum": 12, "maximum": 400}, "bold": {"type": "boolean"}, "italic": {"type": "boolean"}, "underline": {"type": "boolean"}, "color": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"}, "alignment": {"enum": ["left", "center", "right", "justify"]}}}}}},
        {"if": {"properties": {"operation": {"const": "chart_data"}}}, "then": {"properties": {"value": {"type": "object", "required": ["categories", "series"], "additionalProperties": false, "properties": {"categories": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"type": "string"}}, "series": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "object", "required": ["name", "values"], "additionalProperties": false, "properties": {"name": {"type": "string"}, "values": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"type": "number"}}}}}}}}}},
        {"if": {"properties": {"operation": {"const": "table_cell"}}}, "then": {"properties": {"value": {"type": "object", "required": ["row", "column", "text"], "additionalProperties": false, "properties": {"row": {"type": "integer", "minimum": 0}, "column": {"type": "integer", "minimum": 0}, "text": {"type": "string"}}}}}},
        {"if": {"properties": {"operation": {"enum": ["alt_text", "notes"]}}}, "then": {"properties": {"value": {"type": "string"}}}}
      ]
    },
    "model_response": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "scope_level", "scope", "edits", "selections", "ambiguities", "reason"],
      "properties": {
        "status": {"enum": ["resolved", "needs_clarification"]},
        "scope_level": {"enum": ["deck", "section", "slide", "object"]},
        "scope": {"$ref": "#/$defs/scope"},
        "edits": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/edit"}},
        "selections": {"type": "array", "items": {"type": "object", "required": ["object_id", "instruction_quote", "candidate_object_ids", "reason"], "additionalProperties": false, "properties": {"object_id": {"$ref": "object-id.schema.json#/$defs/object_id"}, "instruction_quote": {"type": "string", "minLength": 1}, "candidate_object_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "object-id.schema.json#/$defs/object_id"}}, "reason": {"type": "string", "minLength": 1}}}},
        "ambiguities": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
