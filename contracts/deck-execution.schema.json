{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoloongppt.local/contracts/deck-execution.schema.json",
  "title": "当前Deck/SlideSpec/ExecutionPlan/ObjectMap消费契约；完整对象范围待扩展",
  "oneOf": [
    {
      "$ref": "#/$defs/deck"
    },
    {
      "$ref": "#/$defs/execution"
    },
    {
      "$ref": "#/$defs/object_map"
    }
  ],
  "$defs": {
    "bounds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "object-id.schema.json#/$defs/evidence_id"
      }
    },
    "element": {
      "type": "object",
      "required": [
        "object_id",
        "type",
        "role",
        "bounds",
        "font_size",
        "source_refs"
      ],
      "properties": {
        "object_id": {
          "$ref": "object-id.schema.json#/$defs/object_id"
        },
        "type": {
          "enum": [
            "text",
            "table",
            "chart"
          ]
        },
        "role": {
          "enum": [
            "title",
            "body",
            "data",
            "footer"
          ]
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        },
        "font_size": {
          "type": "number",
          "minimum": 12
        },
        "source_refs": {
          "$ref": "#/$defs/refs"
        },
        "text": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "slide": {
      "type": "object",
      "required": [
        "slide_id",
        "order",
        "intent",
        "content",
        "assets",
        "layout",
        "bindings",
        "elements",
        "style",
        "enhancements",
        "source_refs"
      ],
      "properties": {
        "slide_id": {
          "$ref": "object-id.schema.json#/$defs/slide_id"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "intent": {
          "type": "object"
        },
        "content": {
          "$ref": "generation-model.schema.json#/$defs/slide"
        },
        "assets": {
          "type": "array",
          "maxItems": 0
        },
        "layout": {
          "type": "object"
        },
        "bindings": {
          "type": "array",
          "maxItems": 0
        },
        "elements": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "style": {
          "type": "object"
        },
        "enhancements": {
          "type": "object"
        },
        "source_refs": {
          "$ref": "#/$defs/refs"
        }
      },
      "additionalProperties": false
    },
    "deck": {
      "type": "object",
      "required": [
        "deck_id",
        "title",
        "aspect_ratio",
        "width_inches",
        "height_inches",
        "style",
        "slides",
        "trace_id"
      ],
      "properties": {
        "deck_id": {
          "$ref": "object-id.schema.json#/$defs/deck_id"
        },
        "title": {
          "type": "string"
        },
        "aspect_ratio": {
          "const": "16:9"
        },
        "width_inches": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_inches": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "style": {
          "type": "object"
        },
        "slides": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/slide"
          }
        },
        "trace_id": {
          "$ref": "object-id.schema.json#/$defs/trace_id"
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "calls",
        "deps",
        "backend"
      ],
      "properties": {
        "deps": {
          "type": "string"
        },
        "backend": {
          "const": "PP-05"
        },
        "calls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "call_id",
              "slide_id",
              "capability",
              "implementation_id",
              "backend",
              "deps",
              "inputs",
              "expected_objects",
              "capability_id"
            ],
            "properties": {
              "call_id": {
                "$ref": "object-id.schema.json#/$defs/capability_id"
              },
              "slide_id": {
                "$ref": "object-id.schema.json#/$defs/slide_id"
              },
              "capability": {
                "enum": [
                  "create_slide",
                  "add_text",
                  "add_table",
                  "add_chart",
                  "add_notes"
                ]
              },
              "implementation_id": {
                "$ref": "object-id.schema.json#/$defs/implementation_id"
              },
              "backend": {
                "const": "PP-05"
              },
              "deps": {
                "type": "array",
                "items": {
                  "$ref": "object-id.schema.json#/$defs/capability_id"
                }
              },
              "inputs": {
                "type": "object"
              },
              "expected_objects": {
                "type": "array",
                "items": {
                  "$ref": "object-id.schema.json#/$defs/object_id"
                }
              },
              "capability_id": {
                "$ref": "object-id.schema.json#/$defs/capability_id"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "object_map": {
      "type": "object",
      "required": [
        "objects"
      ],
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "logical_object_id",
              "slide_id",
              "backend_object_id",
              "shape_id",
              "name",
              "type",
              "source_ref",
              "execution_call_id",
              "part"
            ],
            "properties": {
              "logical_object_id": {
                "$ref": "object-id.schema.json#/$defs/object_id"
              },
              "slide_id": {
                "$ref": "object-id.schema.json#/$defs/slide_id"
              },
              "backend_object_id": {
                "type": "string"
              },
              "shape_id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "text",
                  "table",
                  "chart"
                ]
              },
              "source_ref": {
                "$ref": "#/$defs/refs"
              },
              "execution_call_id": {
                "$ref": "object-id.schema.json#/$defs/capability_id"
              },
              "part": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
