{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoloongppt.local/contracts/template-registry-record.schema.json",
  "type": "object",
  "required": [
    "template_id",
    "source",
    "license",
    "sha256",
    "path",
    "version",
    "slide_size",
    "template_pack",
    "design_tokens",
    "preview",
    "status",
    "issues"
  ],
  "properties": {
    "template_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "slide_size": {
      "type": "object"
    },
    "template_pack": {
      "type": "object"
    },
    "design_tokens": {
      "type": "object"
    },
    "preview": {
      "type": "object"
    },
    "status": {
      "const": "partial"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0
    }
  },
  "additionalProperties": false
}
