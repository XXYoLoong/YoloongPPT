{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoloongppt.local/contracts/narrative-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "title": "DEC-006至021独立运行入口",
  "required": [
    "task",
    "sources",
    "context"
  ],
  "properties": {
    "task": {
      "$ref": "task-spec.schema.json"
    },
    "sources": {
      "type": "object",
      "required": [
        "evidence"
      ],
      "properties": {
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "source-evidence.schema.json"
          }
        }
      }
    },
    "context": {
      "type": "object",
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "object",
          "required": [
            "page_count"
          ]
        }
      }
    },
    "proposal": {
      "$ref": "generation-model.schema.json"
    }
  }
}
