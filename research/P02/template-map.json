      ],
      "page_type": "generic claim + evidence; no formal page-type enum",
      "applicability": "所有空白页起点；主机需重写；不保证不同模式/复杂对象",
      "slots": [
        {
          "id": "kicker",
          "selector": ".kicker",
          "kind": "p",
          "geometry": "流式布局，main padding48px",
          "style": {
            "font_px": 14,
            "weight": 700,
            "color": "#8b6a35",
            "margin_bottom_px": 16,
            "letter_spacing_px": 1
          }
        },
        {
          "id": "claim",
          "selector": "h1",
          "kind": "heading",
          "geometry": "flow after kicker",
          "style": {
            "font_px": 44,
            "line_height": 1.12,
            "margin_bottom_px": 24
          }
        },
        {
          "id": "evidence",
          "selector": ".message",
          "kind": "p",
          "geometry": {
            "max_width_px": 900
          },
          "style": {
            "font_px": 22,
            "line_height": 1.45
          }
        }
      ],
      "tokens": [
        "LANGUAGE",
        "WIDTH",
        "HEIGHT",
        "SLIDE_NUMBER"
      ],
      "token_kind": "string replacement; no semantic design token system",
      "inheritance": {
        "body": {
          "background": "#f4f1ea",
          "color": "#182231",
          "font_family": "Arial,sans-serif"
        },
        "universal": "border-box",
        "main": "fixed canvas, padding48, overflow hidden"
      },
      "capacity": "无字符/行数容量；starter会overflow hidden；必须通过实际converter与QA门控"
    }
  ],
