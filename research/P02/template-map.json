      "source_refs": [
        "core:load_state",
        "core:save_state"
      ]
    }
  ],
  "adaptation": [
    {
      "rule": "canvas overflow",
      "value": "scroll-body >1px rejects",
      "source_refs": [
        "converter:getBodyDimensions"
      ]
    },
    {
      "rule": "layout matching",
      "value": "locked dimensions tolerance0.1in",
      "source_refs": [
        "converter:adaptLayout"
      ]
    },
    {
      "rule": "bottom capacity",
      "value": "font>12pt => at least0.5in bottom; original footer failed0.40in",
      "source_refs": [
        "converter:validateTextBoxPosition"
      ],
      "evidence": [
        "validation/footer-revision.json",
        "validation/verify-official-six.json"
      ]
    },
    {
      "rule": "single-line text fit",
      "value": "height<=lineHeight*1.5 => width+2%, alignment compensates",
      "source_refs": [
        "converter:addElements"
      ]
    },
    {
      "rule": "image/effect fit",
      "value": "complex CSS raster; SVG source branch unreachable for tested inline fixture",
      "source_refs": [
        "converter:rasterizeGradients"
      ],
      "evidence": [
        "validation/maps-probes.json"
      ]
    }
  ],
